# ==============================================================================
# LearnHub LMS Marketplace API — Environment Configuration (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# Application Core
# ------------------------------------------------------------------------------
APP_NAME=LearnHub
APP_ENV=local
APP_KEY=base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Logging & Observability
# ------------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=1.0

# ------------------------------------------------------------------------------
# Database (PostgreSQL 16)
# ------------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=learnhub
DB_USERNAME=learnhub_user
DB_PASSWORD=secret
DB_SSLMODE=prefer

# ------------------------------------------------------------------------------
# Redis & Horizon
# ------------------------------------------------------------------------------
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

QUEUE_CONNECTION=redis
HORIZON_PREFIX=learnhub_horizon:

# ------------------------------------------------------------------------------
# Cache, Session & Rate Limiting
# ------------------------------------------------------------------------------
CACHE_STORE=redis
CACHE_PREFIX=learnhub_cache:
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# ------------------------------------------------------------------------------
# Authentication & Sanctum
# ------------------------------------------------------------------------------
SANCTUM_STATEFUL_DOMAINS="localhost:3000,127.0.0.1:3000"
AUTH_PASSWORD_TIMEOUT=10800
AUTH_LOCKOUT_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15

# Socialite OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/api/v1/auth/social/google/callback"

APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_REDIRECT_URI="${APP_URL}/api/v1/auth/social/apple/callback"

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI="${APP_URL}/api/v1/auth/social/facebook/callback"

# ------------------------------------------------------------------------------
# Search Engine (Meilisearch)
# ------------------------------------------------------------------------------
SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=masterKey123

# ------------------------------------------------------------------------------
# Storage & CDN (S3 / MinIO Compatible)
# ------------------------------------------------------------------------------
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadminpassword
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=learnhub-storage
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_ENDPOINT=http://127.0.0.1:9000

# CDN & Signed URL Streaming Configuration
CDN_BASE_URL=http://127.0.0.1:9000/learnhub-storage
CDN_KEY_PAIR_ID=
CDN_PRIVATE_KEY_PATH=
CDN_URL_SIGNING_TTL_MINUTES=120

# ------------------------------------------------------------------------------
# Video Transcoding Pipeline
# Driver options: 'fake' (local dev & testing) | 'mediaconvert' (production AWS)
# ------------------------------------------------------------------------------
VIDEO_PIPELINE_DRIVER=fake
AWS_MEDIACONVERT_ENDPOINT=
AWS_MEDIACONVERT_ROLE_ARN=
AWS_MEDIACONVERT_QUEUE=

# ------------------------------------------------------------------------------
# Payment Gateways (Stripe & extensible gateways)
# ------------------------------------------------------------------------------
PAYMENT_GATEWAY_DEFAULT=stripe
STRIPE_KEY=pk_test_sample
STRIPE_SECRET=sk_test_sample
STRIPE_WEBHOOK_SECRET=whsec_sample
STRIPE_CURRENCY=USD

# ------------------------------------------------------------------------------
# Mail & Notifications (Mailpit for local development)
# ------------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@learnhub.test"
MAIL_FROM_NAME="LearnHub"

# ------------------------------------------------------------------------------
# Scramble OpenAPI Documentation
# ------------------------------------------------------------------------------
SCRAMBLE_ENABLED=true
SCRAMBLE_PATH=docs/api

# ------------------------------------------------------------------------------
# LearnHub Business Engine Settings
# ------------------------------------------------------------------------------
LEARNHUB_DEFAULT_CURRENCY=USD
LEARNHUB_PLATFORM_FEE_PERCENT=20
LEARNHUB_EARNINGS_HOLD_DAYS=30
LEARNHUB_MINIMUM_PAYOUT_AMOUNT_CENTS=5000
LEARNHUB_REFUND_WINDOW_DAYS=30
LEARNHUB_MAX_PROGRESS_FOR_REFUND_PERCENT=10
LEARNHUB_CONCURRENT_STREAM_LIMIT=3
