{
    "name": "learnhub/backend",
    "type": "project",
    "description": "LearnHub LMS Marketplace REST API Backend",
    "keywords": ["laravel", "lms", "marketplace", "api"],
    "license": "proprietary",
    "require": {
        "php": "^8.3 || ^8.4",
        "barryvdh/laravel-dompdf": "^3.0",
        "dedoc/scramble": "^0.11 || ^0.12",
        "laravel/framework": "^11.0 || ^12.0",
        "laravel/horizon": "^5.29",
        "laravel/sanctum": "^4.0",
        "laravel/scout": "^10.11",
        "laravel/socialite": "^5.16",
        "league/flysystem-aws-s3-v3": "^3.0",
        "meilisearch/meilisearch-php": "^1.10",
        "predis/predis": "^2.2",
        "sentry/sentry-laravel": "^4.8",
        "spatie/laravel-permission": "^6.10",
        "spatie/laravel-query-builder": "^5.8 || ^6.0",
        "stripe/stripe-php": "^16.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "laravel/telescope": "^5.2",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.1",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-arch": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump"
        ],
        "test": "pest",
        "test:coverage": "pest --coverage --min=80",
        "lint": "pint",
        "lint:test": "pint --test",
        "analyse": "phpstan analyse --memory-limit=2G",
        "audit": "composer audit",
        "setup": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate --ansi",
            "@php artisan migrate --force"
        ],
        "fresh": [
            "@php artisan migrate:fresh --seed"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
